{
  "name": "norwegian-dictionary",
  "private": true,
  "version": "1.0.0",
  "description": "Norwegian Dictionary — vanilla JS/HTML/CSS with automated crawlable-page builds.",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "build:pages": "python3 scripts/build-static-pages.py",
    "build:updates": "python3 scripts/build-updates-page.py",
    "build:frequency": "python3 scripts/build-vocabulary-frequency.py",
    "export:frequency": "python3 scripts/export-clarino-frequency.py",
    "export:frequency:opensubtitles": "python3 scripts/export-opensubtitles-frequency.py",
    "export:frequency:nb-ngram": "python3 scripts/export-nb-ngram-frequency.py",
    "validate:pages": "python3 scripts/validate-static-pages.py",
    "test:a11y": "python3 scripts/check-accessibility.py",
    "emulators": "PATH=\"/opt/homebrew/opt/openjdk@21/bin:$PATH\" firebase emulators:start --only firestore",
    "dev": "concurrently -n app,firestore -c blue,yellow \"python3 -m http.server 8935\" \"npm run emulators\""
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "axe-core": "^4.13.0",
    "concurrently": "^10.0.5",
    "firebase-tools": "^15.28.2"
  }
}
